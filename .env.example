# Copy to .env.local. Public browser configuration only: never add secrets here.
# Frontend runs on http://localhost:3001; backend runs on http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Set to the real HTTPS API URL before a production build.
# NEXT_PUBLIC_API_URL is baked into the browser bundle at build time.
# It also restricts the CSP connect-src allowlist; API calls are not wired yet.
